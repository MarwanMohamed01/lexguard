{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Throwaway Worker for the M2 CPU experiment (docs/DECISIONS.md D16). Deleted afterwards.
  "name": "lexguard-cpu-probe",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Workers Logs records CPUTimeMs per invocation (Free plan: 200,000 events/day).
  "observability": { "enabled": true },
  "queues": {
    "producers": [{ "binding": "PROBE_QUEUE", "queue": "lexguard-cpu-probe" }],
    // One message per invocation, no retries: each message is one clean measurement.
    "consumers": [{ "queue": "lexguard-cpu-probe", "max_batch_size": 1, "max_retries": 0 }],
  },
}
