{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Worker name: becomes lexguard.<your-subdomain>.workers.dev on deploy.
  "name": "lexguard",
  "main": "src/index.ts",
  // Pins runtime behaviour to this date so Cloudflare updates never change our Worker silently.
  "compatibility_date": "2026-11-01",
  // Workers Logs (free: 200,000 events a day, kept 3 days): errors and CPU time per request.
  // Logs carry error codes and upstream messages only, never document text or keys (T13).
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // System of record: documents, chunks, definitions (schema in migrations/). The ID is not a
  // secret: only code deployed to this account can use the binding.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lexguard",
      "database_id": "cf8c7765-9d5a-4ae0-afac-40c7d96b359f",
      "migrations_dir": "migrations",
    },
  ],
  // Chunking job (src/chunking.ts): one instance per converted document. Indexing job
  // (src/indexing.ts): started by the chunking job when it finishes. Created on deploy.
  "workflows": [
    {
      "name": "lexguard-chunk-document",
      "binding": "CHUNK_DOCUMENT",
      "class_name": "ChunkDocument",
    },
    {
      "name": "lexguard-index-document",
      "binding": "INDEX_DOCUMENT",
      "class_name": "IndexDocument",
    },
  ],
  // Chunk vectors (bge-m3, 1,024 dimensions, cosine), one namespace per tenant, metadata
  // index on "doc". NOT created by deploy: created once with `wrangler vectorize create`
  // (D29), and only with Marwan's OK.
  // `remote: true`: `wrangler dev` uses the real index (Vectorize has no local simulation, as
  // for AI below); tests never connect (remoteBindings: false in vitest.config.ts).
  "vectorize": [{ "binding": "VECTORS", "index_name": "lexguard-chunks", "remote": true }],
  // Workers AI: env.AI.toMarkdown converts uploaded PDF/DOCX to Markdown (free for those
  // formats; images would use neurons, so uploads are limited to PDF and DOCX).
  "ai": { "binding": "AI", "remote": true },
  // Secret names only (values are set with `wrangler secret put`, or .dev.vars locally).
  // TENANT_KEYS: JSON object mapping SHA-256(api key) in hex to a tenant ID.
  "secrets": { "required": ["TENANT_KEYS"] },
  // More bindings (Queues...) are added in later milestones.
}
