{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The rulebook MCP server (M5 step 4, D46/D47): lexguard-rulebook.<subdomain>.workers.dev.
  "name": "lexguard-rulebook",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // nodejs_compat: the MCP SDK imports node:process. global_fetch_strictly_public: required by
  // the OAuth library to fetch Client ID Metadata Documents safely (no same-zone routing, SSRF).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // The public origin: the OAuth issuer and the MCP resource are derived from it, and tokens
  // are bound to `${PUBLIC_ORIGIN}/mcp`. Tests override it.
  "vars": { "PUBLIC_ORIGIN": "https://lexguard-rulebook.marwan-dev.workers.dev" },
  // OAuth grants, client records and token hashes (never tokens themselves). Free KV: 1,000
  // writes a day (D43). NOT created yet: created once with `wrangler kv namespace create
  // OAUTH_KV`, with Marwan's OK, before the first deploy; its id is then added here.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // The main Worker's private TenantAuth entrypoint: checks the API key a person signs in with
  // on the consent page (D47). A service binding, not a URL: never on the public internet.
  "services": [{ "binding": "TENANT_AUTH", "service": "lexguard", "entrypoint": "TenantAuth" }],
}
