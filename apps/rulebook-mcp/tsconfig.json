{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Workers runtime types come from worker-configuration.d.ts (`npm run types`); the test
    // helpers' types from the Workers Vitest plugin.
    "types": ["@cloudflare/vitest-plugin/types"],
    "resolveJsonModule": true
  },
  "include": ["src", "test", "worker-configuration.d.ts", "vitest.config.ts"]
}
